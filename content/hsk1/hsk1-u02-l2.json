    {
      "type": "grammar",
      "title": "Counting people and things with 个",
      "body": "In Chinese you can't put a number straight before a noun. You need a measure word in between, and 个 is the most common one: number + 个 + noun. For 'two' before a measure word, say 两, not 二. To ask 'how many?' (usually expecting a small number), put 几 in place of the number: 几个.",
      "examples": [
        {
          "zh": "两个老师",
          "en": "two teachers"
        },
        {
          "zh": "我们是三个人。",
          "en": "There are three of us."
        },
        {
          "zh": "你们是几个人？",
          "en": "How many of you are there?"
        }
      ]
    },
