    {
      "type": "grammar",
      "title": "Asking 'who?' and 'which country?'",
      "body": "To ask 'who', put 谁 exactly where the answer would go: 他是老师 becomes 他是谁？ The word order doesn't change, and you don't add 吗. To ask where someone is from, say 哪国人 ('which-country person'): 你是哪国人？ The answer simply replaces 哪国 with the country: 我是中国人.",
      "examples": [
        {
          "zh": "他是谁？",
          "en": "Who is he?"
        },
        {
          "zh": "你是哪国人？",
          "en": "Which country are you from?"
        },
        {
          "zh": "我是中国人。",
          "en": "I'm Chinese."
        }
      ]
    },
