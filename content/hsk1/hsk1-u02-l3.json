    {
      "type": "grammar",
      "title": "Asking someone's age",
      "body": "To ask an adult or someone your own age, say 你多大？ (literally 'you how big?'). For a young child, say 你几岁？, because 几 expects a small number. Answer with the number plus 岁. You don't need 是 in the answer.",
      "examples": [
        {
          "zh": "你多大？我二十岁。",
          "en": "How old are you? I'm twenty."
        },
        {
          "zh": "你几岁？我六岁。",
          "en": "How old are you? I'm six."
        },
        {
          "zh": "他今年多大？他三十多岁。",
          "en": "How old is he this year? He's in his thirties."
        }
