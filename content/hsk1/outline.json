{
  "units": [
    {
      "id": "hsk1-u01",
      "title": "Greetings & Introductions",
      "title_zh": "你好",
      "theme": "communication",
      "description": "Greet people, say who you are, ask simple questions and use basic polite expressions.",
      "lessons": [
        {
          "id": "hsk1-u01-l1",
          "title": "Hello and Goodbye",
          "words": [
            "你",
            "好",
            "我",
            "您",
            "再见",
            "谢谢",
            "不客气"
          ],
          "grammar": "greetings: 你好 / 您好"
        },
        {
          "id": "hsk1-u01-l2",
          "title": "Who Are You?",
          "words": [
            "是",
            "不",
            "他",
            "她",
            "老师",
            "学生",
            "中国",
            "人",
            "对"
          ],
          "grammar": "是 sentences: A 是 B, negated with 不是"
        },
        {
          "id": "hsk1-u01-l3",
          "title": "We, You and They",
          "words": [
            "吗",
            "们",
            "我们",
            "你们",
            "他们",
            "她们",
            "大家"
          ],
          "grammar": "yes-no questions with 吗"
        },
        {
          "id": "hsk1-u01-l4",
          "title": "What's Your Name?",
          "words": [
            "叫",
            "什么",
            "名字",
            "认识",
            "很",
            "高兴",
            "也",
            "呢"
          ],
          "grammar": "follow-up questions with 呢 (你呢？)"
        },
        {
          "id": "hsk1-u01-l5",
          "title": "Being Polite",
          "words": [
            "对不起",
            "没关系",
            "请",
            "请问",
            "先生",
            "女士",
            "谁",
            "哪",
            "国"
          ],
          "grammar": "question words 谁 and 哪 (哪国人)"
        }
      ]
    },
