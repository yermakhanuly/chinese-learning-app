{
  "id": "g2-result-complements",
  "level": 2,
  "title": "完, 好, 到, 懂, 错: result after a verb",
  "topic": "complements",
  "summary": "Lets you say what result an action had, as in 吃完了, 听懂了 and 写错了.",
  "structure": [
    "Verb + Result + 了",
    "没 + Verb + Result",
    "Verb + Result + 了吗？"
  ],
  "explanation": "A second word after the verb shows the RESULT: 吃完 'finish eating', 听懂 'understand (by listening)', 写错 'write wrongly', 找到 'find', 做好 'get it done well'. Usually 了 follows: 我吃完了.\n\nThe negative is 没 + verb + result, without 了: 我没听懂 'I didn't understand.' This is how Chinese separates trying (听 'listen') from succeeding (听懂 'understand').",
  "examples": [
    {
      "zh": "我吃完了。",
      "en": "I've finished eating."
    },
    {
      "zh": "你听懂了吗？",
      "en": "Did you understand?"
    },
    {
      "zh": "我没听懂。",
      "en": "I didn't understand."
    },
    {
      "zh": "这个字我写错了。",
      "en": "I wrote this character wrong."
    },
    {
      "zh": "你找到手机了吗？",
      "en": "Did you find your phone?"
    }
  ],
  "mistakes": [
    {
      "wrong": "我完吃了。",
      "right": "我吃完了。",
      "why": "The result word goes after the verb."
    },
    {
      "wrong": "我没听懂了。",
      "right": "我没听懂。",
      "why": "Drop 了 after 没."
    }
  ],
  "related": [
    "g1-kanjian",
    "g2-direction-complements",
    "g2-de-degree"
  ],
