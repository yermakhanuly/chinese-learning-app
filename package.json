    "db:backup": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/backup-db.ts",
    "check:admin": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-admin.ts",
    "check:billing": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-billing.ts",
